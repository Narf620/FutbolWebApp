Use AllWebUIServerClasses.pkg
Use cConnection.pkg
Use cWebMenuItemLoadView.pkg

Object oApplication is a cApplication
    Object oConnection is a cConnection
        Use LoginEncryption.pkg
    End_Object
End_Object

Object oWebApp is a cWebApp
    Set psTheme to "Df_Material"
    Set peApplicationStateMode to asmHistoryAndUrls
    Set psEncryptPassword to "2Zp*)9Yw~Z$1OO.#cN`]Y_y_?~Wdb}(u@D<xToY:"
    
    Object oViewStack is a cWebViewStack
End_Object

    Object oCommandbar is a cWebCommandBar                
        Object oMenuBar is a cWebMenuBar
            Object oFileMenu is a cWebMenuItem
                Set psCaption to C_$File
                
                Object oClearMenuItem is a cWebMenuClear
                End_Object  
                             
                Object oClearAllMenuItem is a cWebMenuClearAll
                End_Object  
                
                Object oPromptMenuItem is a cWebMenuPrompt
                    Set pbBeginGroup to True
                End_Object  
                               
                Object oFindMenuItem is a cWebMenuFind
                End_Object  

                Object oNextMenuItem is a cWebMenuFindNext
                End_Object  

                Object oPreviousMenuItem is a cWebMenuFindPrevious
                End_Object  
                
                Object oLastMenuItem is a cWebMenuFindLast
                End_Object                
                                
                Object oFirstMenuItem is a cWebMenuFindFirst
                End_Object  
                
                Object oSaveMenuItem is a cWebMenuSave
                    Set pbBeginGroup to True
                End_Object  
                
                Object oDeleteMenuItem is a cWebMenuDelete
                End_Object  
                
                Object oLoginMenuItem is a cWebMenuItem
                    Set psCaption to C_$LogIn
                    Set pbBeginGroup to True
                    Set psCSSClass to "WebLoginMenuItem"

                    Procedure OnClick
                        Send RequestLogin to (SessionManager(Self))
                    End_Procedure
                    
                    Procedure OnLoad
                        Integer eLoginMode
                        Handle hoLogin
                        Get GetLoginView to hoLogin
                        Get peLoginMode to eLoginMode
                        WebSet pbRender to  (hoLogin and eLoginMode<>lmLoginNone)
                    End_Procedure  // OnLoad
                    
                End_Object  

                Object oLogoutMenuItem is a cWebMenuItem
                    Set psCaption to C_$LogOut
                    Set psCSSClass to "WebLogoutMenuItem"

                    Procedure OnClick
                        Send RequestLogOut of (SessionManager(Self))
                    End_Procedure

                    Procedure OnLoad
                        Integer eLoginMode
                        Handle hoLogin
                        Get GetLoginView to hoLogin
                        Get peLoginMode to eLoginMode
                        WebSet pbRender to  (hoLogin and eLoginMode<>lmLoginNone)
                    End_Procedure
                End_Object  
            End_Object  
    
            Object oViewMenu is a cWebMenuItem
                Set psCaption to C_$View
                
                Object oDashboardItem is a cWebMenuItemLoadView
    Set psCaption to "Dashboard"
    Set psLoadViewOnClick to "oDashboard"
End_Object

                Object oSeleccionarEntrenadorItem1 is a cWebMenuItemLoadView
                    Set psCaption to "Seleccionar Entrenador"
                    Set psLoadViewOnClick to "oSelectEntrenador"
                End_Object

                Object oDatosyedicindeentrenadoresItem1 is a cWebMenuItemLoadView
                    Set psCaption to "Datos y edición de entrenadores."
                    Set psLoadViewOnClick to "oZoomEntrenador"
                End_Object

                Object oSeleccindelosequiposdeftbolItem1 is a cWebMenuItemLoadView
                    Set psCaption to "Selección de los equipos de fútbol."
                    Set psLoadViewOnClick to "oSelectEquipo"
                End_Object

                Object oConsultaryeditardatosdeequiposItem1 is a cWebMenuItemLoadView
                    Set psCaption to "Consultar y editar datos de equipos."
                    Set psLoadViewOnClick to "oZoomEquipo"
                End_Object

                Object oSeleccindejugadoresItem1 is a cWebMenuItemLoadView
                    Set psCaption to "Selección de jugadores."
                    Set psLoadViewOnClick to "oSelectJugador"
                End_Object

                Object oConsultaryeditardatosdejugadoresItem1 is a cWebMenuItemLoadView
                    Set psCaption to "Consultar y editar datos de jugadores."
                    Set psLoadViewOnClick to "oZoomJugador"
                End_Object

                Object oSeleccionarposicionesdeftbolItem1 is a cWebMenuItemLoadView
                    Set psCaption to "Seleccionar posiciones de fútbol."
                    Set psLoadViewOnClick to "oSelectPosicion"
                End_Object

                Object oConsultaryeditardatosdeposicionesItem1 is a cWebMenuItemLoadView
                    Set psCaption to "Consultar y editar datos de posiciones."
                    Set psLoadViewOnClick to "oZoomPosicion"
                End_Object

                Object oSeleccindelasligasdeftbolItem1 is a cWebMenuItemLoadView
                    Set psCaption to "Selección de las ligas de fútbol."
                    Set psLoadViewOnClick to "oSelectLiga"
                End_Object

                Object oConsultaryeditardatosdeligasItem1 is a cWebMenuItemLoadView
                    Set psCaption to "Consultar y editar datos de ligas."
                    Set psLoadViewOnClick to "oZoomLiga"
                End_Object
            End_Object  
        End_Object  
        
        Object oFindToolBar is a cWebToolBar
            Object oFirstMenuItem is a cWebMenuFindFirst
            End_Object  
    
            Object oPreviousMenuItem is a cWebMenuFindPrevious
            End_Object  

            Object oFindMenuItem is a cWebMenuFind
            End_Object  

            Object oNextMenuItem is a cWebMenuFindNext
            End_Object  
            
            Object oLastMenuItem is a cWebMenuFindLast
            End_Object
                           
            Object oPromptMenuItem is a cWebMenuPrompt
            End_Object 
        End_Object
        
        Object oFileToolBar is a cWebToolBar
            Set pbShowCaption to True
            
            Object oClearMenuItem is a cWebMenuClear
            End_Object              
             
            Object oClearAllMenuItem is a cWebMenuClearAll
            End_Object   
                        
            Object oSaveMenuItem is a cWebMenuSave
            End_Object  
            
            Object oDeleteMenuItem is a cWebMenuDelete
            End_Object 
        End_Object
    End_Object

    Use SessionManager.wo
    Use LoginDialog.wo
    Use WebResourceManager.wo
    Use Dashboard.wo
    Use SelectEntrenador.wo
    Use ZoomEntrenador.wo
    Use SelectEquipo.wo
    Use ZoomEquipo.wo
    Use SelectJugador.wo
    Use ZoomJugador.wo
    Use SelectPosicion.wo
    Use ZoomPosicion.wo
    Use SelectLiga.wo
    Use ZoomLiga.wo
    Use cWebViewStack.pkg
    
End_Object

Send StartWebApp of oWebApp
